import os

# 1. Define the folder and file name
folder = str(input("Enter the folder name: "))
filename = str(input("Enter the file name: "))

# 2. Create the folder if it does not exist
if not os.path.exists(folder):
    os.makedirs(folder)

# 3. Create the full file path safely
file_path = os.path.join(folder, filename)

# 4. Create and write content to the file


print(f"File successfully created at: {file_path}")

# 5. Verify the file exists using the OS library
if os.path.isfile(file_path):
    print("Verification success: The file exists.")
